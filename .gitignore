.*
!/.gitignore

# local GitHub token (never commit)
/.github-token
/.git-credentials

# local dev server config (browser-sync extensionless middleware)
/bs-config.js

# local CV scratch (served copies live at repo root)
/docs/

# WRITING_STYLE.md is tracked on purpose: it lives in the repo but is kept off
# the published site by the exclude list in _config.yml.